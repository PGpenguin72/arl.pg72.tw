{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "arl-pg72-tw",
  "account_id": "9e1e36d2ce92a214f3e9dbb96b0be9d2",
	"main": "src/worker.ts",
	"compatibility_date": "2026-08-27",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": "pages",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "arl-pg72-tw",
			"database_id": "52f4dd6a-e808-47da-9667-46da36b039a4"
		}
	],
	"vars": {
		"OIDC_ISSUER": "https://sso.pg72.tw",
		"GEMINI_MODEL": "gemini-2.5-flash"
	}
}
